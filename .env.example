# ==============================================================================
# Cortex TIP - Configurações de Ambiente (.env)
# ==============================================================================

# Banco de Dados Dedicado (MariaDB em Docker)
DB_ENGINE=mariadb

# Conexão com o Contêiner MariaDB Docker
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cortex_system
DB_USER=cortex_user
DB_PASSWORD=cortex_secret_2026
DB_ROOT_PASSWORD=cortex_root_secret_2026

# Segurança da Aplicação Flask
SECRET_KEY=generate_a_random_32_bytes_secret_key_here
FLASK_PORT=80
FLASK_HOST=0.0.0.0
